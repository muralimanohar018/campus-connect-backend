# ---------------------------------------------------------------------------
# Campus Connect Backend — Environment Configuration
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL connection string (Supabase in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_connect?schema=public"

# JWT secrets — generate strong random secrets for production
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Comma-separated list of allowed origins, or * for all (dev only)
CORS_ORIGIN=*

# Cloudinary (optional — leave blank to disable cloud uploads in dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

LOG_LEVEL=info
